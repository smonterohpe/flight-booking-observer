[Unit]
Description=Zerto Probe (agrega datos de proteccion de datos para Observability Console)
After=network.target

[Service]
Type=simple
User=probe
Group=probe
WorkingDirectory=/opt/zerto-probe
EnvironmentFile=/opt/zerto-probe/.env
ExecStart=/opt/zerto-probe/venv/bin/uvicorn main:app --host 0.0.0.0 --port 5002
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
